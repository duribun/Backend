# ⚠️ 템플릿입니다. 실제 값을 채운 .env 파일은 EC2 서버 안에만 두고, 절대 git에 커밋하지 마세요.
# docs/DEPLOY-AWS.md 참고. 사용법: EC2에서 이 파일을 .env로 복사한 뒤 값을 채우고
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build

# -----------------------------------------------------------------------------
# 배포 도메인 — Caddy가 이 값으로 Let's Encrypt HTTPS 인증서를 자동 발급한다.
# 구매한 도메인의 서브도메인(예: api.duribun.site)을 EC2 Elastic IP로 A레코드 연결해두고 사용.
# -----------------------------------------------------------------------------
DOMAIN=

# -----------------------------------------------------------------------------
# Database (PostgreSQL - EC2 안 Docker 컨테이너, 로컬 개발용과 다른 새 비밀번호로 발급)
# -----------------------------------------------------------------------------
DB_NAME=duribun
DB_USERNAME=duribun
DB_PASSWORD=

# -----------------------------------------------------------------------------
# JWT — 운영용 시크릿, 아래 명령으로 새로 발급해서 채운다(로컬 dev 기본값 재사용 금지)
#   openssl rand -base64 64
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=14

# -----------------------------------------------------------------------------
# OAuth2 — 각 콘솔에 운영용 패키지명(com.duribun.app) + release keystore SHA-1을
# 등록한 뒤 발급되는 값으로 채운다(docs/DEPLOY-AWS.md "소셜 로그인 재등록" 참고).
# -----------------------------------------------------------------------------
OAUTH_GOOGLE_WEB_CLIENT_ID=
OAUTH_KAKAO_REST_API_KEY=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# TourAPI 4.0 (한국관광공사 - map 도메인)
# -----------------------------------------------------------------------------
TOUR_API_SERVICE_KEY=

# -----------------------------------------------------------------------------
# AWS S3 (여행기록 사진 업로드)
# EC2에 S3 접근 권한이 있는 IAM Role을 붙였다면 이 두 값은 비워둬도 SDK가 자동으로
# 그 Role 자격증명을 사용한다(권장 — 액세스 키를 서버에 두지 않아도 됨).
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
